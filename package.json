{
  "name": "dsh-github-manager",
  "version": "1.2.0",
  "type": "module",
  "description": "只读的 GitHub 仓库查看面板 + 一个 GitHub 管理技能：在 dsh 内登录 GitHub，面板用来看，AI 用你的账户来操作仓库、Issue、PR。A read-only GitHub repository viewer plus a model-invocable GitHub management skill.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "github",
    "github-api",
    "credentials",
    "git",
    "skill"
  ],
  "license": "MIT",
  "author": "LLL-lyh0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLL-lyh0/dsh-github-manager.git"
  },
  "bugs": {
    "url": "https://github.com/LLL-lyh0/dsh-github-manager/issues"
  },
  "homepage": "https://github.com/LLL-lyh0/dsh-github-manager#readme",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skill",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
